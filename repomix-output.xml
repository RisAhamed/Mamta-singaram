            </Field>
          </div>
        </Section>

        {/* ── Section 8 — Document Upload ─────────────────────────────────── */}
        <Section title="Document Upload">
          <div className="space-y-3">
            <p className="text-xs text-slate-500">
              <Paperclip className="inline h-3.5 w-3.5 mr-1 align-text-bottom text-slate-400" />
