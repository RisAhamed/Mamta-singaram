                aria-label="Close modal"
              >
                <X className="h-5 w-5" />
              </button>
            </div>

            <form onSubmit={handleSubmit} className="space-y-4 px-6 py-5">
              <div>
                <label htmlFor="name" className="block text-sm font-medium text-slate-700">
                  Full Name <span className="text-rose-600">*</span>
                </label>
                <input
                  id="name"
